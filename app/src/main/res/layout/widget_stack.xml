<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_widget" android:padding="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_sprout" android:contentDescription="@null" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="AgriSense" android:textColor="@color/matcha_ink" android:textSize="14sp" android:fontFamily="@font/nunito_black" android:maxLines="1"/>
    <LinearLayout android:id="@+id/pill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/pill_stale">
    <ImageView android:id="@+id/dot_pill" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/dot_stale" android:layout_marginEnd="5dp"/>
    <TextView android:id="@+id/tv_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="@color/stale" android:textSize="11sp" android:fontFamily="@font/nunito_bold" android:maxLines="1"/>
</LinearLayout>
</LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="9dp" android:paddingEnd="9dp" android:background="@drawable/bg_tile">
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_thermo" android:contentDescription="@null" android:layout_marginEnd="6dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temp" android:textColor="@color/mute" android:textSize="10sp" android:fontFamily="@font/nunito_bold" android:maxLines="1" /></LinearLayout>
    <TextView android:id="@+id/tv_temp" android:layout_width="0dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:layout_weight="1" android:text="–" android:textColor="@color/ink" android:fontFamily="@font/nunito_black" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="9dp" android:paddingEnd="9dp" android:background="@drawable/bg_tile">
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_drop" android:contentDescription="@null" android:layout_marginEnd="6dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Humidity" android:textColor="@color/mute" android:textSize="10sp" android:fontFamily="@font/nunito_bold" android:maxLines="1" /></LinearLayout>
    <TextView android:id="@+id/tv_hum" android:layout_width="0dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:layout_weight="1" android:text="–" android:textColor="@color/ink" android:fontFamily="@font/nunito_black" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="9dp" android:paddingEnd="9dp" android:background="@drawable/bg_tile">
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_leaf" android:contentDescription="@null" android:layout_marginEnd="6dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Soil" android:textColor="@color/mute" android:textSize="10sp" android:fontFamily="@font/nunito_bold" android:maxLines="1" /></LinearLayout>
    <TextView android:id="@+id/tv_soil" android:layout_width="0dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:layout_weight="1" android:text="–" android:textColor="@color/ink" android:fontFamily="@font/nunito_black" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
    <TextView android:id="@+id/tv_updated" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" android:textColor="@color/faint" android:textSize="10sp" android:fontFamily="@font/nunito_semi" android:maxLines="1"/>
    <ImageView android:id="@+id/btn_refresh" android:layout_width="22dp" android:layout_height="22dp" android:padding="3dp" android:src="@drawable/ic_refresh" android:contentDescription="Refresh"/>
</LinearLayout>
</LinearLayout>
</FrameLayout>
