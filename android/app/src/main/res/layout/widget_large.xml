<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_widget" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_sprout" android:contentDescription="@null" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="AgriSense" android:textColor="@color/matcha_ink" android:textSize="14sp" android:fontFamily="@font/nunito_black" android:maxLines="1"/>
    <LinearLayout android:id="@+id/pill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/pill_stale">
    <View android:id="@+id/dot_pill" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/dot_stale" android:layout_marginEnd="5dp"/>
    <TextView android:id="@+id/tv_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textColor="@color/stale" android:textSize="11sp" android:fontFamily="@font/nunito_bold" android:maxLines="1"/>
</LinearLayout>
</LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" android:layout_marginTop="6dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_tile">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_leaf" android:contentDescription="@null" android:layout_marginEnd="5dp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Soil moisture" android:textColor="@color/mute" android:textSize="11sp" android:fontFamily="@font/nunito_bold" android:maxLines="1" />
            <TextView android:id="@+id/tv_soil_state" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="" android:textColor="@color/soil" android:textSize="11sp" android:fontFamily="@font/nunito_bold" android:maxLines="1"/>
        </LinearLayout>
        <TextView android:id="@+id/tv_soil" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|start" android:text="–" android:textColor="@color/matcha_ink" android:fontFamily="@font/nunito_black" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="44sp" android:autoSizeStepGranularity="1sp"/>
        <ProgressBar android:id="@+id/pb_soil" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_soil" android:indeterminate="false"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_tile">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_thermo" android:contentDescription="@null" android:layout_marginEnd="4dp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temperature" android:textColor="@color/mute" android:textSize="10sp" android:fontFamily="@font/nunito_bold" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/tv_temp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|start" android:text="–" android:textColor="@color/ink" android:fontFamily="@font/nunito_black" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="32sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="3dp" android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_tile">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_drop" android:contentDescription="@null" android:layout_marginEnd="4dp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Humidity" android:textColor="@color/mute" android:textSize="10sp" android:fontFamily="@font/nunito_bold" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/tv_hum" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|start" android:text="–" android:textColor="@color/ink" android:fontFamily="@font/nunito_black" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="32sp" android:autoSizeStepGranularity="1sp"/>
</LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
    <TextView android:id="@+id/tv_updated" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" android:textColor="@color/faint" android:textSize="10sp" android:fontFamily="@font/nunito_semi" android:maxLines="1"/>
    <ImageView android:id="@+id/btn_refresh" android:layout_width="22dp" android:layout_height="22dp" android:padding="3dp" android:src="@drawable/ic_refresh" android:contentDescription="Refresh"/>
</LinearLayout>
</LinearLayout>
</FrameLayout>
